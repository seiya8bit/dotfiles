# Agents start PowerShell too, so only a person at a terminal gets past this point.
if ([Console]::IsInputRedirected -or [Console]::IsOutputRedirected -or $env:CLAUDECODE) {
    return
}
{{- range $tool := .tools }}{{ with (index $tool "human") }}
{{ . | trim }}
{{- end }}{{ end }}

function update {
    chezmoi update
    if ($LASTEXITCODE -eq 0) {
        winget upgrade --all --accept-package-agreements --accept-source-agreements
{{- range $tool := .tools }}{{ with (index $tool "upgrade") }}
        {{ . }}
{{- end }}{{ end }}
    }
}
