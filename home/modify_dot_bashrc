{{/* chezmoi:modify-template */}}
{{- $content := .chezmoi.stdin -}}
{{- if not (lstat (joinPath .chezmoi.destDir ".bashrc")) -}}
{{- $content = include "/etc/skel/.bashrc" -}}
{{- end -}}
{{- $pattern := `(?ms)^# >>> dotfiles: zoxide >>>\n.*?^# <<< dotfiles: zoxide <<<(\n|$)` -}}
{{- $markers := regexFindAll `(?m)^# (>>> dotfiles: zoxide >>>|<<< dotfiles: zoxide <<<)` $content -1 -}}
{{- $blocks := regexFindAll $pattern $content -1 -}}
{{- if ne (len $markers) (mul 2 (len $blocks)) -}}
{{- fail "Unbalanced zoxide block markers in .bashrc; repair them before applying" -}}
{{- end -}}
{{- $content = $content | replaceAllRegex $pattern "" -}}
{{- $content -}}
{{- if and $content (not (hasSuffix "\n" $content)) }}{{ "\n" }}{{ end -}}
# >>> dotfiles: zoxide >>>
if [[ $- == *i* ]] && command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi
# <<< dotfiles: zoxide <<<
