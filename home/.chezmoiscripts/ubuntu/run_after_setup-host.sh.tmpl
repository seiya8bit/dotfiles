{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "Ubuntu host setup failed at line $LINENO; resolve the reported problem and rerun chezmoi apply." >&2' ERR

die() {
    echo "$*" >&2
    exit 1
}

etc=/etc
run=/run

# shellcheck disable=SC1091
. "$etc/os-release"
arch=$(dpkg --print-architecture)
[[ $EUID != 0 && $ID == ubuntu && $VERSION_ID == 26.04 && ( $arch == amd64 || $arch == arm64 ) ]] ||
    die 'Run as a normal user on Ubuntu Server 26.04 LTS amd64 or arm64.'

kernel=$(uname -r)
[[ ${kernel,,} != *microsoft* && $kernel != *tegra* && ! -e $etc/nv_tegra_release ]] ||
    die 'WSL and Jetson/L4T need platform-specific host setup.'

systemctl show --property=Version --value >/dev/null
apt_updated=false

installed() {
    [[ $(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null) == installed ]]
}

install_missing() {
    local package missing=()

    for package; do
        if ! installed "$package"; then
            missing+=("$package")
        fi
    done

    if (( ${#missing[@]} == 0 )); then
        return
    fi

    if ! $apt_updated; then
        sudo apt-get -o APT::Update::Error-Mode=any update
        apt_updated=true
    fi
    sudo env DEBIAN_FRONTEND=noninteractive UCF_FORCE_CONFFOLD=1 apt-get -y \
        --no-remove --no-upgrade --no-install-recommends \
        -o Dpkg::Options::=--force-confold install -- "${missing[@]}"
}

check_path() {
    local path=$1

    [[ ! -e $path || -f $path ]] || die "Expected a regular file: $path"

    while [[ $path != / ]]; do
        [[ ! -L $path ]] || die "Resolve the symbolic link manually: $path"
        path=$(dirname -- "$path")
        [[ ! -e $path || ( -d $path && -x $path ) ]] || die "Expected an accessible directory: $path"
    done
}

publish() {
    check_path "$2"

    if [[ -e $2 ]]; then
        cmp -s "$1" "$2" || die "Existing file differs; review manually: $2"
    else
        sudo mkdir -p -- "$(dirname -- "$2")"
        sudo cp --update=none-fail --preserve=mode -T -- "$1" "$2"
    fi
}

repository() {
    local url=$2 sha=$3 repo=$4 \
        key="$etc/apt/keyrings/$1.asc" source="$etc/apt/sources.list.d/$1.list" file

    shopt -s nullglob
    for file in "$etc/apt/sources.list" "$etc/apt/sources.list.d/"*.list "$etc/apt/sources.list.d/"*.sources; do
        [[ ! -f $file || $file == "$source" ]] && continue
        if grep -Fq "${url%/*}" "$file"; then
            die "Use the existing repository in $file manually."
        fi
    done

    curl --fail --location --silent --show-error "$url" --output "$temporary/key"
    printf '%s  %s\n' "$sha" "$temporary/key" | sha256sum --check --status

    printf 'deb [arch=%s signed-by=%s] %s\n' "$arch" "$key" "$repo" > "$temporary/source"
    chmod 644 "$temporary/key" "$temporary/source"

    publish "$temporary/key" "$key"
    publish "$temporary/source" "$source"
    apt_updated=false
}

start_enabled() {
    local state

    state=$(systemctl is-enabled "$1" 2>/dev/null) || :
    case "$state" in
        enabled|enabled-runtime|static|indirect)
            if ! systemctl is-active --quiet "$1"; then
                sudo systemctl start "$1"
            fi
            ;;
        disabled|masked*)
            echo "Manual action: $1 is $state; its startup policy is unchanged."
            ;;
        *)
            die "Unexpected service state '$state': $1"
            ;;
    esac
}

setup_docker() {
    # Install Toolkit before new Docker: Docker detects the NVIDIA CDI hook at daemon startup.
    if $new_docker; then
        repository docker https://download.docker.com/linux/ubuntu/gpg \
            1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570 \
            'https://download.docker.com/linux/ubuntu resolute stable'
    fi

    if $new_docker || installed docker-ce; then
        install_missing docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    elif installed docker.io; then
        install_missing docker-compose-v2 docker-buildx
    fi

    docker --version
    compose=$(docker compose version --short)
    docker buildx version

    if installed docker-ce || installed docker.io; then
        user=$(id -un)
        if [[ " $(id -nG "$user") " != *' docker '* ]]; then
            sudo usermod -aG docker "$user"
        fi
        if [[ " $(id -nG) " != *' docker '* ]]; then
            echo 'Manual action: log out and back in for root-equivalent Docker group access.'
        fi

        start_enabled docker.service
    fi
}

setup_nvidia() {
    install_missing pciutils
    gpus=$(lspci -Dnm -d 10de::03xx)
    reboot_pending=false

    if [[ -z $gpus ]]; then
        return
    fi

    installed nvidia-l4t-core && die 'Jetson/L4T requires platform-specific NVIDIA setup.'

    local driver_detected=true
    if command -v nvidia-smi >/dev/null; then
        nvidia-smi -L || driver_detected=false
    else
        [[ -r /proc/driver/nvidia/version ]] || driver_detected=false
    fi

    if ! $driver_detected; then
        drivers=$(grep -E \
            '^(nvidia-(driver|headless|dkms|kernel|utils|compute-utils)-|linux-modules-nvidia-|libnvidia-(compute|gl)-).* (installed|unpacked|half-[^ ]+|triggers-[^ ]+)$' \
            <<< "$inventory" || :)

        if [[ -n $drivers ]] || command -v nvidia-smi >/dev/null || command -v nvidia-uninstall >/dev/null; then
            pending=$(sed -nE 's/^nvidia-(driver|headless(-no-dkms)?)-([0-9]+(-server)?(-open)?)(:[^ ]+)? installed$/\3/p' <<< "$drivers" | sort -u)

            # shellcheck disable=SC2015
            [[ -n $pending && $pending != *$'\n'* && -f $run/reboot-required.pkgs ]] &&
                ! grep -Eq ' (unpacked|half-[^ ]+|triggers-[^ ]+)$' <<< "$drivers" &&
                grep -Eq "^linux-modules-nvidia-$pending-[^ ]+ installed$" <<< "$drivers" &&
                grep -Eq '^(nvidia-|linux-)' "$run/reboot-required.pkgs" ||
                die 'Existing NVIDIA driver could not be verified; check module loading and driver health. It will not be replaced.'
        else
            install_missing ubuntu-drivers-common
            recommendation=$(ubuntu-drivers list --gpgpu --recommended)
            read -r driver modules extra <<< "$recommendation"

            [[ $recommendation != *$'\n'* && $driver =~ ^nvidia-driver-[0-9]+(-server)?(-open)?$ && -z $extra &&
                $modules == linux-modules-nvidia-"${driver#nvidia-driver-}"-* && $modules =~ ^[a-z0-9.+-]+$ ]] ||
                die 'No unambiguous recommended driver with signed modules; check GPU/kernel support manually.'

            # Signed modules satisfy the driver's DKMS dependency.
            install_missing "$modules"
            install_missing "$driver"
        fi

        reboot_pending=true
    fi

    if ! installed nvidia-container-toolkit-base; then
        repository nvidia-container-toolkit https://nvidia.github.io/libnvidia-container/gpgkey \
            c880576d6cf75a48e5027a871bac70fd0421ab07d2b55f30877b21f1c87959c9 \
            "https://nvidia.github.io/libnvidia-container/stable/deb/$arch /"
        install_missing nvidia-container-toolkit-base
    fi

    start_enabled nvidia-cdi-refresh.path
}

verify_nvidia() {
    if [[ -z $gpus ]]; then
        echo 'No NVIDIA PCI GPU; skipping NVIDIA setup.'
        return
    fi

    dpkg --compare-versions "${compose#v}" ge 2.30.0 ||
        die 'Compose 2.30+ is required for gpus: all; upgrade using the original package source manually.'

    if $reboot_pending; then
        echo 'Manual action: reboot, complete Secure Boot enrollment if requested, then rerun apply. GPU readiness is not verified.'
        return
    fi

    if ! command -v nvidia-smi >/dev/null; then
        nvidia-ctk cdi generate --mode=nvml --output= >/dev/null ||
            die 'NVIDIA CDI generation failed; diagnose the driver and Toolkit manually.'
    fi

    nvidia-ctk cdi list | grep -Fx 'nvidia.com/gpu=all' >/dev/null ||
        die 'CDI device missing; inspect nvidia-cdi-refresh.service.'

    if ! systemctl is-active --quiet docker.service; then
        echo 'Manual action: start the local Docker service to use GPU containers.'
        return
    fi

    version=$(sudo docker --host unix:///run/docker.sock info --format '{{ "{{.ServerVersion}}" }}')
    dpkg --compare-versions "$version" ge 29.2 ||
        die 'Native --gpus support requires Docker 29.2+; upgrade using the original package source manually.'

    sudo docker --host unix:///run/docker.sock info --format '{{ "{{range .DiscoveredDevices}}{{println .ID}}{{end}}" }}' |
        grep -Fx 'nvidia.com/gpu=all' >/dev/null ||
        die 'Docker cannot discover the NVIDIA CDI device; review its CDI configuration manually.'

    # ponytail: startup-time hook discovery needs a manual restart for an already running daemon.
    started=$(systemctl show --property=ExecMainStartTimestamp --value docker.service)
    started=$(date -d "$started" +%s)
    hook_installed=$(stat -c %Z /usr/bin/nvidia-cdi-hook)

    if (( started <= hook_installed )); then
        echo 'Manual action: restart Docker during a maintenance window (or reboot) to activate --gpus all, then rerun apply.'
    fi
}

# Check Docker conflicts before installing any packages.
inventory=$(dpkg-query -W -f='${binary:Package} ${db:Status-Status}\n')
new_docker=false
if ! installed docker-ce && ! installed docker.io && ! command -v docker >/dev/null; then
    ! command -v dockerd >/dev/null || die 'Repair the existing Docker installation manually.'
    if grep -Eq '^(docker|containerd|runc|podman-docker).* (installed|unpacked|half-[^ ]+|triggers-[^ ]+)$' <<< "$inventory"; then
        die 'Conflicting or incomplete container packages exist; no automatic migration.'
    fi
    [[ ! -e $etc/docker && ! -L $etc/docker ]] || die 'Review existing Docker settings before installing.'
    new_docker=true
fi

install_missing zoxide
if ! installed openssh-server; then
    check_path "$etc/ssh/sshd_config"
    [[ ! -e $etc/ssh/sshd_config ]] || die 'Review existing SSH settings before installing openssh-server.'
fi
install_missing openssh-server
sudo /usr/sbin/sshd -G >/dev/null
if ! systemctl is-active --quiet ssh.service && ! systemctl is-active --quiet ssh.socket; then
    if systemctl is-enabled --quiet ssh.service; then
        start_enabled ssh.service
    else
        start_enabled ssh.socket
    fi
fi

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

setup_nvidia
setup_docker
verify_nvidia
{{ end -}}
