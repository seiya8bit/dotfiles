{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
#!/usr/bin/env bash
set -euo pipefail

# Install only missing tools; afterwards each tool's official updater or package source owns its version.
export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$HOME/.local/bin"

missing() {
    ! command -v "$1" >/dev/null 2>&1
}

run_installer() {
    local url=$1 installer
    shift
    installer=$(curl --fail --location --silent --show-error "$url")
    "$@" <<< "$installer"
}

if missing tailscale; then
    run_installer https://tailscale.com/install.sh env TRACK=stable sh
fi
if missing claude; then
    run_installer https://claude.ai/install.sh bash -s -- stable
fi
if missing codex; then
    run_installer https://chatgpt.com/codex/install.sh env CODEX_NON_INTERACTIVE=1 sh
fi
if missing opencode; then
    # The installer only supports ~/.opencode/bin; link it instead of letting it edit shell files.
    run_installer https://opencode.ai/install bash -s -- --no-modify-path
    ln -s -- "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"
fi

for command in tailscale claude codex opencode; do
    "$command" --version
done
{{ end -}}
