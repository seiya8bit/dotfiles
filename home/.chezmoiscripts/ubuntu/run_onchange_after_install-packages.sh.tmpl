{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") (not (env "WSL_DISTRO_NAME")) -}}
#!/usr/bin/env bash
set -euo pipefail
# mise tools: {{ include "dot_config/mise/config.toml" | sha256sum }}

# Password login is disabled below, so a key must already allow access.
if [[ ! -s $HOME/.ssh/authorized_keys ]]; then
    echo "Add your SSH public key to $HOME/.ssh/authorized_keys, then apply again." >&2
    exit 1
fi

# shellcheck disable=SC1091
. /etc/os-release
GNUPGHOME=$(mktemp -d)
export GNUPGHOME
trap 'rm -rf -- "$GNUPGHOME"' EXIT

apt_install() {
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-remove \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -- "$@"
}

# Add a vendor APT repository that trusts only the key with the expected fingerprint.
repository() {
    local name=$1 url=$2 fingerprint=$3 key=/etc/apt/keyrings/$1.gpg
    shift 3

    curl --fail --location --silent --show-error "$url" | gpg --quiet --import
    gpg --export "$fingerprint" > "$GNUPGHOME/$name.gpg"
    if [[ ! -s $GNUPGHOME/$name.gpg ]]; then
        echo "The $name signing key does not match $fingerprint." >&2
        exit 1
    fi
    sudo install -D -m 644 "$GNUPGHOME/$name.gpg" "$key"
    printf '%s\n' 'Types: deb' "$@" "Signed-By: $key" | sudo tee "/etc/apt/sources.list.d/$name.sources" > /dev/null
}

sudo apt-get update
apt_install ca-certificates curl gnupg openssh-server tmux unattended-upgrades zoxide

# Security updates also cover vendor packages that do not restart containers.
printf '%s\n' 'Unattended-Upgrade::Origins-Pattern {' '    "site=pkgs.tailscale.com";' \
    '    "site=downloads.claude.ai";' '    "site=mise.jdx.dev";' '};' |
    sudo tee /etc/apt/apt.conf.d/52dotfiles-unattended-upgrades > /dev/null

# sshd keeps the first value it reads, so this sorts before the installer's 50-cloud-init.conf.
printf '%s\n' 'PasswordAuthentication no' 'KbdInteractiveAuthentication no' |
    sudo tee /etc/ssh/sshd_config.d/10-dotfiles.conf > /dev/null
if systemctl is-active --quiet ssh; then
    sudo systemctl reload ssh
fi

# bootstrap.sh adds the same mise files; this re-verifies the key and carries a new fingerprint to existing machines.
repository mise https://mise.jdx.dev/gpg-key.pub 24853EC9F655CE80B48E6C3A8B81C9D17413A06D \
    'URIs: https://mise.jdx.dev/deb' 'Suites: stable' 'Components: main'
repository docker https://download.docker.com/linux/ubuntu/gpg 9DC858229FC7DD38854AE2D88D81803C0EBFCD88 \
    'URIs: https://download.docker.com/linux/ubuntu' "Suites: $VERSION_CODENAME" 'Components: stable'
repository tailscale "https://pkgs.tailscale.com/stable/ubuntu/$VERSION_CODENAME.noarmor.gpg" 2596A99EAAB33821893C0A79458CA832957F5868 \
    'URIs: https://pkgs.tailscale.com/stable/ubuntu' "Suites: $VERSION_CODENAME" 'Components: main'
repository claude-code https://downloads.claude.ai/keys/claude-code.asc 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE \
    'URIs: https://downloads.claude.ai/claude-code/apt/stable' 'Suites: stable' 'Components: main'

sudo apt-get update
apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin tailscale claude-code mise
sudo usermod -aG docker "$(id -un)"

mise install

if [[ -e /run/reboot-required ]]; then
    echo 'Reboot to finish the installation.'
else
    echo 'Log out and back in to use Docker without sudo.'
fi
{{ end -}}
