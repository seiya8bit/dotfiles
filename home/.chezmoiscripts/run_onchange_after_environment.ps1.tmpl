{{ if eq .chezmoi.destDir .chezmoi.homeDir -}}
$ErrorActionPreference = 'Stop'

# Agents start shells without a profile, so what they need lives in the user environment.
$path = @(
{{- range $name, $tool := .tools }}{{ range (index $tool "path") }}
    '{{ . | replace "'" "''" }}'
{{- end }}{{ end }}
)

$environment = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey('Environment')
try {
    # DOTFILES_PATH records the last apply, so dropped entries are undone. Read PATH unexpanded
    # to keep the user's %VARIABLE% references, but drop expanded copies of ours.
    $previous = "$($environment.GetValue('DOTFILES_PATH'))" -split ';' -ne ''
    $expanded = $path | ForEach-Object { [Environment]::ExpandEnvironmentVariables($_) }
    $entries = ("$($environment.GetValue('Path', '', 'DoNotExpandEnvironmentNames'))" -split ';' -ne '') |
        Where-Object { $_ -notin $previous -and [Environment]::ExpandEnvironmentVariables($_) -notin $expanded }
    $environment.SetValue('Path', (@($path) + @($entries)) -join ';', 'ExpandString')
} finally {
    $environment.Dispose()
}
# .NET also tells running programs, such as Explorer, to reload the environment.
[Environment]::SetEnvironmentVariable('DOTFILES_PATH', $path -join ';', 'User')
{{ end -}}
