{{ if eq .chezmoi.destDir .chezmoi.homeDir -}}
$ErrorActionPreference = 'Stop'

# Agents start shells without a profile, so mise shims must be on the user PATH.
$shims = '%LOCALAPPDATA%\mise\shims'
$expanded = [Environment]::ExpandEnvironmentVariables($shims)

$environment = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey('Environment')
try {
    # Read PATH unexpanded to keep the user's %VARIABLE% references, but drop expanded copies of ours.
    $entries = ("$($environment.GetValue('Path', '', 'DoNotExpandEnvironmentNames'))" -split ';' -ne '') |
        Where-Object { [Environment]::ExpandEnvironmentVariables($_) -ne $expanded }
    $environment.SetValue('Path', (@($shims) + @($entries)) -join ';', 'ExpandString')
} finally {
    $environment.Dispose()
}
# Clearing an unused variable makes .NET tell running programs, such as Explorer, to reload the environment.
[Environment]::SetEnvironmentVariable('DOTFILES_RELOAD', [NullString]::Value, 'User')
{{ end -}}
