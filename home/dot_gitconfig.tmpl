[init]
    defaultBranch = main

[user]
    name = {{ .gitName | quote }}
    email = {{ .gitEmail | quote }}

[core]
    autocrlf = false
    quotePath = false
    longPaths = true
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

[fetch]
    prune = true

[pull]
    ff = only

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3
