{{ if eq .chezmoi.os "windows" -}}
# Global defaults; projects pin their own versions.
[tools]
node = "lts"

[settings]
idiomatic_version_file_enable_tools = ["node"]
{{ else -}}
# Personal CLIs without an APT repository; `update` keeps them at the latest release.
[tools]
chezmoi = "latest"
codex = "latest"
{{ end -}}
