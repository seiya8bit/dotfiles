{{- if ne .chezmoi.os "windows" -}}
{{- fail "These dotfiles support Windows 11 only" -}}
{{- end -}}
{{- $gitName := promptStringOnce . "gitName" "Git name" | trim -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email" | trim -}}
{{- if or (not $gitName) (not $gitEmail) -}}
{{- fail "Git name and email must not be empty" -}}
{{- end -}}
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}

[interpreters.ps1]
command = "pwsh"
args = ["-NoLogo", "-NoProfile", "-File"]
